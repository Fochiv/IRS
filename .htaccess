Options -Indexes
DirectoryIndex index.php

# Security headers (only if mod_headers is available)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# Allow PDF/images to display inline for document previews
<FilesMatch "\.(pdf|jpg|jpeg|png|gif|webp)$">
    <IfModule mod_headers.c>
        Header set Content-Disposition "inline"
    </IfModule>
</FilesMatch>

# Protect sensitive files (Apache 2.4 compatible)
<FilesMatch "\.(sql|log|env|ini|conf)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Protect hidden files (dot files)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
